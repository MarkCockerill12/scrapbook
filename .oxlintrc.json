{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "nextjs"],
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["node_modules", ".next", "raw", "public/dev-assets"],
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "env": { "node": true, "browser": false },
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
