{
  "name": "scrapbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint",
    "assets:process": "node scripts/images/process.mjs",
    "assets:usage": "node scripts/r2/usage.mjs",
    "assets:upload": "node scripts/r2/upload.mjs",
    "shots": "node scripts/shots.mjs",
    "assets:cutout": "node scripts/images/cutout.mjs",
    "assets:coverage": "node scripts/images/coverage.mjs",
    "assets:harvest": "node scripts/images/harvest.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "onnxruntime-node",
    "sharp",
    "unrs-resolver"
  ]
}
